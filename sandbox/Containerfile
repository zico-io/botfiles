# botfiles-agent — sandbox image for autonomous harness agents.
# One microVM per mission (Apple `container`); each agent runs as a
# `container exec` process inside it. Built by sandbox/build.sh.
# See .botfile/memory/tools/sandbox.md.

FROM debian:trixie-slim

# Node 24 from NodeSource: eve (Vercel agent framework) requires Node >=24, and
# 24 still satisfies pi's bundled undici 8.x, which calls worker_threads
# markAsUncloneable (absent in Debian trixie's Node 20, so pi crashed on boot).
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates python3 build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Full Rust toolchain for in-guest agents: fmt / clippy / test / build the crate,
# plus cargo-deny + cargo-llvm-cov (prebuilt via cargo-binstall, no compile) so the
# entire CI gate runs inside the mission VM. build-essential (above) is the C
# toolchain rusqlite's bundled SQLite needs; llvm-tools-preview backs llvm-cov.
# ripgrep is the real `rg` binary the bob eve harness's search_content/search_files
# tools spawn (the interactive shells' `rg` is a Claude Code function, not on PATH
# for node's spawn); binstall'd here so every eve spawn has it. apt has no rg pkg.
# System-wide CARGO_HOME/RUSTUP_HOME so every `container exec` session sees it.
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
        -c rustfmt -c clippy -c llvm-tools-preview \
    && curl -L --proto '=https' --tlsv1.2 -sSf \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall -y cargo-deny cargo-llvm-cov ripgrep \
    && rm -rf "$CARGO_HOME/registry"

# Harnesses (all node CLIs, linux/arm64). Coordination is the host orbal-net server
# reached via the `orbal-net` CLI (installed below via provision.sh) - no in-guest
# coordination daemon. ponytail: if a harness has no linux/arm64 build, drop it
# here — don't fake it.
RUN npm install -g \
      @anthropic-ai/claude-code \
      @openai/codex \
      @earendil-works/pi-coding-agent \
      vercel

# Bake the SSOT and reuse the host provisioner to wire AGENTS.md into each
# harness's in-guest config (HOME=/root at build time). This also installs the
# `orbal-net` binary agents call to reach the mission's host orbal-net server
# over TCP (ORBAL_NET_URL/ORBAL_NET_TOKEN/ORBAL_NET_AGENT are injected per
# `container exec`) - `cargo install` lands it in $CARGO_HOME/bin, already on
# PATH from the Rust-toolchain step above.
COPY AGENTS.md /opt/botfiles/AGENTS.md
COPY skills /opt/botfiles/skills
COPY provision.sh /opt/botfiles/provision.sh
RUN chmod +x /opt/botfiles/provision.sh && /opt/botfiles/provision.sh

# wcommit — the serialized commit wrapper workers use since they share one clone.
COPY bin/wcommit /usr/local/bin/wcommit
RUN chmod +x /usr/local/bin/wcommit

COPY sandbox/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

# This whole image is the sandbox boundary, so the harnesses' root-guard on
# --dangerously-skip-permissions is redundant here. IS_SANDBOX=1 is claude's
# supported opt-out for exactly this containerized case.
ENV IS_SANDBOX=1

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["sleep", "infinity"]
