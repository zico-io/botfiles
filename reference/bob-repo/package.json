{
  "name": "bob",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bob: production eve harness for one orbal-net leaf worker role (RFC S9 step 3, mission eve-harness-v0). Ported and hardened from the eve-harness PoC.",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --import ./test/register-ts-js-resolve-hook.mjs test/spawn-tools-argv.test.ts && node --experimental-strip-types --import ./test/register-ts-js-resolve-hook.mjs test/confirm-gate.test.ts && node --experimental-strip-types --import ./test/register-ts-js-resolve-hook.mjs test/spawn-tools-confirm.test.ts",
    "bob": "bin/bob",
    "bob:tui": "node --experimental-strip-types client/bob-tui.ts",
    "connector": "node --experimental-strip-types connector/main.ts",
    "proof:durable": "node --experimental-strip-types proofs/durable.ts",
    "proof:leaf": "node --experimental-strip-types proofs/leaf-smoke.ts",
    "proof:coexistence": "node --experimental-strip-types proofs/coexistence.ts",
    "proof:shared-server": "node --experimental-strip-types proofs/shared-server.ts",
    "proof:confirm-gate": "node --experimental-strip-types proofs/confirm-gate-eve.ts",
    "repro:eve-533": "node --experimental-strip-types proofs/eve-approval-bug-repro.ts",
    "proof:approval-tui": "node --experimental-strip-types proofs/approval-tui.ts",
    "proof:approval-wire": "node --experimental-strip-types proofs/approval-wire.ts"
  },
  "dependencies": {
    "@vercel/connect": "0.2.2",
    "ai": "^7.0.0",
    "eve": "0.22.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "just-bash": "^3.0.0",
    "microsandbox": "^0.5.10",
    "typescript": "7.0.1-rc"
  },
  "overrides": {
    "ai": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
