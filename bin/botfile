#!/usr/bin/env python3
"""botfile - portable agent-memory CLI.

Subcommands:
  validate       check entities.jsonl, memory index completeness, inline provenance
  budget-check   assert root instruction files stay under the line budget
  wire --tool T  point a harness (codex|claude|all) at this repo's AGENTS.md,
                 link bin/forge into ~/.local/bin, and for claude register the
                 hook that sends bare `git push` to `forge push`

No third-party deps. The derived vector store / MCP search from the handoff plan
is deliberately not built: the memory tree is a handful of markdown files and
grep searches it instantly. Add retrieval when grep actually hurts.
"""
import importlib.util
import json
import os
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
MEM = REPO / ".botfile" / "memory"
ENTITIES = REPO / ".botfile" / "entities" / "entities.jsonl"
PUSH_GUARD = REPO / "hooks" / "forge-push-guard.py"

# ponytail: single budget value, so it lives here, not in a yaml parser + dep.
ROOT_MAX_LINES = 200
ROOT_FILES = ["AGENTS.md"]

ENTITY_FIELDS = ["canonical_id", "name", "type", "aliases", "source", "date"]
DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}")
SOURCE_RE = re.compile(r"<source:[^>]*\d{4}-\d{2}-\d{2}[^>]*>")


def provenance_gaps(text):
    """Line numbers of top-level `- ` bullets lacking <source: …, date>.
    A bullet may wrap across indented continuation lines; check the whole block.
    """
    gaps, start, block = [], None, ""
    def close():
        if start is not None and not SOURCE_RE.search(block):
            gaps.append(start)
    for n, line in enumerate(text.splitlines(), 1):
        if line.startswith("- "):
            close()
            start, block = n, line
        elif start is not None and (line.startswith(" ") or line.startswith("\t")):
            block += " " + line
        else:
            close()
            start, block = None, ""
    close()
    return gaps


def fail(errs):
    for e in errs:
        print(f"  FAIL: {e}", file=sys.stderr)
    return 1


def validate():
    errs = []

    # 1. entities.jsonl - valid JSONL, required fields, unique canonical_id.
    seen = set()
    for n, line in enumerate(ENTITIES.read_text().splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError as e:
            errs.append(f"entities.jsonl:{n} invalid JSON: {e}")
            continue
        for f in ENTITY_FIELDS:
            if f not in obj:
                errs.append(f"entities.jsonl:{n} missing field '{f}'")
        if not isinstance(obj.get("aliases"), list):
            errs.append(f"entities.jsonl:{n} 'aliases' must be a list")
        cid = obj.get("canonical_id")
        if cid in seen:
            errs.append(f"entities.jsonl:{n} duplicate canonical_id '{cid}'")
        seen.add(cid)

    # 2. index.md lists exactly the memory files that exist.
    index = MEM / "index.md"
    indexed = {
        str((index.parent / m).resolve())
        for m in re.findall(r"\(([^)]+\.md)\)", index.read_text())
    }
    actual = {
        str(p.resolve())
        for p in MEM.rglob("*.md")
        if p.name != "index.md"
    }
    for missing in sorted(actual - indexed):
        errs.append(f"memory file not listed in index.md: {os.path.relpath(missing, REPO)}")
    for dangling in sorted(indexed - actual):
        errs.append(f"index.md links a missing file: {os.path.relpath(dangling, REPO)}")

    # 3. Every top-level fact bullet carries inline <source: …, date> provenance.
    for p in sorted(MEM.rglob("*.md")):
        if p.name == "index.md":
            continue
        for ln in provenance_gaps(p.read_text()):
            errs.append(f"{os.path.relpath(p, REPO)}:{ln} "
                        f"fact bullet missing <source: …, YYYY-MM-DD>")

    if errs:
        return fail(errs)
    print("validate ok")
    return 0


def budget_check():
    errs = []
    for name in ROOT_FILES:
        f = REPO / name
        lines = len(f.read_text().splitlines())
        status = "ok" if lines <= ROOT_MAX_LINES else "OVER"
        print(f"  {name}: {lines}/{ROOT_MAX_LINES} lines [{status}]")
        if lines > ROOT_MAX_LINES:
            errs.append(f"{name} is {lines} lines, over the {ROOT_MAX_LINES}-line budget")
    if errs:
        return fail(errs)
    print("budget-check ok")
    return 0


def with_push_guard(settings, command):
    """`settings` with exactly one PreToolUse Bash entry running `command`.
    Entries for an older checkout's guard are replaced, so rewiring converges.
    """
    hooks = settings.setdefault("hooks", {})
    pre = [
        entry for entry in hooks.get("PreToolUse", [])
        if not any(h.get("command", "").endswith(PUSH_GUARD.name) for h in entry.get("hooks", []))
    ]
    pre.append({"matcher": "Bash", "hooks": [{"type": "command", "command": command}]})
    hooks["PreToolUse"] = pre
    return settings


def wire(tool):
    home = Path.home()

    def link(target, source):
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.is_symlink() or target.exists():
            target.unlink()
        target.symlink_to(source)
        print(f"  linked {target} -> {source}")

    def register_push_guard():
        path = home / ".claude" / "settings.json"
        settings = json.loads(path.read_text()) if path.exists() else {}
        command = f"python3 {PUSH_GUARD}"
        path.write_text(json.dumps(with_push_guard(settings, command), indent=2) + "\n")
        print(f"  registered PreToolUse hook in {path}: {command}")

    tools = ["codex", "claude"] if tool == "all" else [tool]
    for t in tools:
        link(home / f".{t}" / "AGENTS.md", REPO / "AGENTS.md")
        if t == "claude":
            register_push_guard()
    link(home / ".local" / "bin" / "forge", REPO / "bin" / "forge")
    return 0


def selfcheck():
    ok = "- fact <source: spec, 2026-07-07>"
    wrapped = "- fact that wraps\n  onto a line <source: spec, 2026-07-07>"
    bad = "- fact with no provenance"
    bad_date = "- fact <source: spec>"
    assert provenance_gaps(ok) == [], "single-line good bullet flagged"
    assert provenance_gaps(wrapped) == [], "wrapped good bullet flagged"
    assert provenance_gaps(bad) == [1], "missing provenance not caught"
    assert provenance_gaps(bad_date) == [1], "missing date not caught"
    assert provenance_gaps(bad + "\n" + ok) == [1], "wrong bullet flagged in mix"

    other = {"hooks": [{"type": "command", "command": "tuios agent-hook"}]}
    stale = {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 /old/hooks/forge-push-guard.py"}]}
    wired = with_push_guard({"hooks": {"PreToolUse": [other, stale]}, "model": "x"}, "python3 /new/hooks/forge-push-guard.py")
    assert wired == {"model": "x", "hooks": {"PreToolUse": [
        other, {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 /new/hooks/forge-push-guard.py"}]}]}}, wired
    assert with_push_guard(json.loads(json.dumps(wired)), "python3 /new/hooks/forge-push-guard.py") == wired, "rewire not idempotent"

    spec = importlib.util.spec_from_file_location("push_guard", PUSH_GUARD)
    guard = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(guard)
    denied = ["git push", "git push -u origin feat", "cd x && git push", "make; git  push --force",
              "(git push)", "ls\ngit push"]
    allowed = ["forge push", "git -C repo push", "command git push", "git pushy", "echo 'git push'",
               "git status", "git commit -m 'then git push later'"]
    assert [c for c in denied if not guard.decide(c)] == [], "bare git push not denied"
    assert [c for c in allowed if guard.decide(c)] == [], "non-bare push denied"
    assert guard.decide("git push")["hookSpecificOutput"]["permissionDecisionReason"] == "use `forge push`"
    print("selfcheck ok")
    return 0


def main(argv):
    if not argv:
        print(__doc__)
        return 1
    cmd = argv[0]
    if cmd == "validate":
        return validate()
    if cmd == "budget-check":
        return budget_check()
    if cmd == "selfcheck":
        return selfcheck()
    if cmd == "wire":
        tool = None
        for i, a in enumerate(argv[1:]):
            if a == "--tool" and i + 2 <= len(argv[1:]):
                tool = argv[1:][i + 1]
        if tool not in ("codex", "claude", "all"):
            print("usage: botfile wire --tool {codex|claude|all}", file=sys.stderr)
            return 1
        return wire(tool)
    print(f"unknown command: {cmd}\n{__doc__}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
