#!/usr/bin/env python3
"""toolbox - one search/use front door for agent skills and MCP integrations.

Agents see two tools instead of hundreds of ambient skill and MCP tool
definitions:

  search(query)       rank catalog entries against a task description
  use(tool, prompt)   run one: a skill returns its instructions for the caller to
                      follow; an MCP integration runs in a scoped `claude -p`
                      subagent that sees only that server's tools

Subcommands:
  search QUERY...     print the best matches
  use TOOL PROMPT...  print a skill's instructions, or an integration's result
  list                print every catalog entry
  mcp                 serve search/use as an MCP stdio server
  selfcheck           unit-check the parser, ranking, and MCP handshake

The catalog is toolbox/catalog.json (override with $TOOLBOX_CATALOG). No
third-party deps.
"""
import argparse
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import threading
from datetime import datetime
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CATALOG = Path(os.environ.get("TOOLBOX_CATALOG", REPO / "toolbox" / "catalog.json"))
PLUGINS = Path.home() / ".claude" / "plugins" / "installed_plugins.json"
CLAUDE = os.environ.get("TOOLBOX_CLAUDE", "claude")
MODEL = os.environ.get("TOOLBOX_MODEL", "claude-sonnet-5-5")
USE_TIMEOUT_S = 900

RUNNER_PROMPT = (
    "You run the `{name}` integration for another agent. Fulfil the request using "
    "only its tools (find them with ToolSearch). Do exactly what is asked, nothing "
    "more. Reply with only what the caller needs: the data, IDs, URLs, or what "
    "changed. If it cannot be done, say why in one line. Current local time: {now}."
)
INSTRUCTIONS = (
    "The toolbox holds skills (step-by-step playbooks) and integrations (Notion, "
    "Gmail, Google Calendar/Drive, Granola, Datadog, Vercel, Bask, LangSmith, and "
    "more) that are not loaded as tools. Before saying you cannot do something, or "
    "when a task matches a known workflow, call search, then use."
)


# --- catalog ---------------------------------------------------------------

BLOCK_SCALARS = {">", ">-", ">+", "|", "|-", "|+"}


def scalar(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] == '"':
        try:
            return json.loads(v)
        except json.JSONDecodeError:
            return v[1:-1]
    if len(v) >= 2 and v[0] == v[-1] == "'":
        return v[1:-1].replace("''", "'")
    return v


def frontmatter(text):
    """(top-level string fields, body) of a Markdown file with YAML frontmatter.
    ponytail: handles the scalar shapes SKILL.md files use (plain, quoted, block,
    wrapped plain); nested maps are skipped. Swap in PyYAML if that stops holding.
    """
    lines = text.lstrip("\n").split("\n")
    if not lines or lines[0].strip() != "---":
        return {}, text
    try:
        end = lines.index("---", 1)
    except ValueError:
        return {}, text
    fields, key, block = {}, None, None
    for line in lines[1:end]:
        m = re.match(r"([A-Za-z0-9_-]+):\s*(.*)$", line)
        if m and not line[0].isspace():
            key, raw = m.group(1), m.group(2).strip()
            block = raw[0] if raw in BLOCK_SCALARS else None
            fields[key] = "" if block or not raw else scalar(raw)
        elif key and line.strip():
            sep = "\n" if block == "|" else " "
            fields[key] = (fields[key] + sep + line.strip()).strip()
    return fields, "\n".join(lines[end + 1 :]).lstrip("\n")


def truthy(v):
    return str(v).strip().lower() in ("true", "yes", "1")


def skill_files(root):
    """SKILL.md dirs and flat command .md files directly under root."""
    if not root.is_dir():
        return []
    return sorted(root.glob("*/SKILL.md")) + sorted(p for p in root.glob("*.md") if p.is_file())


def skill_entry(path, prefix):
    fields, body = frontmatter(path.read_text(errors="replace"))
    if truthy(fields.get("disable-model-invocation", "")):
        return None
    name = fields.get("name") or (path.parent.name if path.name == "SKILL.md" else path.stem)
    desc = fields.get("description") or next(
        (l.lstrip("# ").strip() for l in body.splitlines() if l.strip()), ""
    )
    return {"name": prefix + name, "kind": "skill", "description": desc, "path": str(path)}


def plugin_roots(ids):
    """(skills/commands dir, name prefix) for each installed plugin id."""
    try:
        installed = json.loads(PLUGINS.read_text())["plugins"]
    except (OSError, KeyError, ValueError):
        return []
    roots = []
    for pid in ids:
        for inst in installed.get(pid, [])[:1]:
            base = Path(inst["installPath"])
            prefix = pid.split("@")[0] + ":"
            roots += [(base / "skills", prefix), (base / "commands", prefix)]
    return roots


def load(catalog_path=None):
    """Every catalog entry, first definition of a name wins."""
    path = Path(catalog_path or CATALOG)
    cat = json.loads(path.read_text())
    shared = os.environ.get("BASK_SKILLS_ROOT")
    roots = (
        [(Path(shared).expanduser() / category, "") for category in ("build", "content", "research")]
        if shared else []
    )
    roots += [(path.parent / os.path.expanduser(r), "") for r in cat.get("skills", [])]
    roots += plugin_roots(cat.get("plugins", []))
    entries, seen = [], set()

    def add(e):
        if e and e["name"].lower() not in seen:
            seen.add(e["name"].lower())
            entries.append(e)

    for name, cfg in cat.get("mcp", {}).items():
        add({"name": name, "kind": "integration", "description": cfg.get("description", ""),
             "config": {k: v for k, v in cfg.items() if k != "description"}})
    for root, prefix in roots:
        for f in skill_files(root):
            add(skill_entry(f, prefix))
    return entries


# --- search ----------------------------------------------------------------

STOP = set("a an and are as at be by can do for from how i in into is it me my of on or "
           "the this to use using want we what when with you your".split())


def stem(w):
    for suf in ("ing", "ed", "es", "s"):
        if len(w) > len(suf) + 3 and w.endswith(suf):
            return w[: -len(suf)]
    return w


def terms(text):
    return [stem(w) for w in re.findall(r"[a-z0-9]+", text.lower()) if w not in STOP]


NAME_WEIGHT = 3  # a word in the name counts like three in the description


def search(entries, query, limit=8):
    """BM25 over name + description, name words weighted up.
    ponytail: no embeddings; a few hundred entries rank fine on words. Add a
    reranker when searches start missing obvious tools.
    """
    docs = [terms(re.sub(r"[-_:]", " ", e["name"])) * NAME_WEIGHT + terms(e["description"])
            for e in entries]
    if not docs:
        return []
    avg = sum(map(len, docs)) / len(docs)
    df = {}
    for d in docs:
        for t in set(d):
            df[t] = df.get(t, 0) + 1
    ranked = []
    for e, d in zip(entries, docs):
        score = 0.0
        for t in set(terms(query)):
            tf = d.count(t)
            if tf:
                idf = math.log(1 + (len(docs) - df[t] + 0.5) / (df[t] + 0.5))
                score += idf * tf * 2.2 / (tf + 1.2 * (0.25 + 0.75 * len(d) / avg))
        if score:
            ranked.append((score, e))
    ranked.sort(key=lambda se: (-se[0], se[1]["name"]))
    return [e for _, e in ranked[:limit]]


def format_hits(hits):
    if not hits:
        return "No matches. Try other words, or `list` via the CLI to see everything."
    out = []
    for e in hits:
        desc = " ".join(e["description"].split())
        out.append(f"- {e['name']} [{e['kind']}]: {desc[:240] + '...' if len(desc) > 240 else desc}")
    return "\n".join(out) + "\n\nRun one with use(tool=<name>, prompt=<the full task>)."


# --- use -------------------------------------------------------------------


class ToolboxError(Exception):
    pass


def resolve(entries, name):
    by_name = {e["name"].lower(): e for e in entries}
    e = by_name.get(name.lower())
    if not e:
        near = ", ".join(h["name"] for h in search(entries, name, 5))
        raise ToolboxError(f"no tool named {name!r}." + (f" Closest: {near}" if near else ""))
    return e


def use_skill(e, prompt):
    path = Path(e["path"])
    _, body = frontmatter(path.read_text(errors="replace"))
    return (
        f"Skill `{e['name']}` loaded. Follow these instructions to complete the task.\n"
        f"Base directory (resolve relative paths here): {path.parent}\n"
        f"Task: {prompt}\n\n{body.replace('$ARGUMENTS', prompt)}"
    )


def runner_argv(e, prompt):
    name, cfg = e["name"], e["config"]
    claudeai = cfg.get("type") == "claudeai"
    now = datetime.now().astimezone().isoformat(timespec="minutes")
    argv = [CLAUDE, "-p", prompt, "--model", MODEL, "--no-session-persistence",
            "--setting-sources", "project", "--disable-slash-commands", "--tools", "ToolSearch",
            "--system-prompt", RUNNER_PROMPT.format(name=name, now=now),
            "--allowedTools", ("mcp__claude_ai_" if claudeai else "mcp__") + name]
    if not claudeai:
        argv += ["--strict-mcp-config", "--mcp-config", json.dumps({"mcpServers": {name: cfg}})]
    return argv


def use_integration(e, prompt):
    # The subagent runs from an empty dir with user settings off, so no ambient
    # skills, hooks, or deny rules; blocking connects make claude.ai connectors
    # visible on the first turn instead of racing it.
    env = dict(os.environ, MCP_CONNECTION_NONBLOCKING="0")
    env.setdefault("MCP_CONNECT_TIMEOUT_MS", "30000")
    with tempfile.TemporaryDirectory(prefix="toolbox-") as cwd:
        try:
            r = subprocess.run(runner_argv(e, prompt), cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=USE_TIMEOUT_S)
        except FileNotFoundError:
            raise ToolboxError(f"{CLAUDE!r} not found; set $TOOLBOX_CLAUDE")
        except subprocess.TimeoutExpired:
            raise ToolboxError(f"{e['name']} did not finish within {USE_TIMEOUT_S}s")
    if r.returncode:
        raise ToolboxError(f"{e['name']} failed (exit {r.returncode}): {(r.stderr or r.stdout).strip()[-2000:]}")
    return r.stdout.strip()


def use(entries, name, prompt):
    e = resolve(entries, name)
    return use_skill(e, prompt) if e["kind"] == "skill" else use_integration(e, prompt)


# --- MCP stdio server ------------------------------------------------------

TOOLS = [
    {
        "name": "search",
        "description": "Search the toolbox for a skill or integration that fits a task. "
        "Describe the task in plain words; returns ranked tool names with descriptions.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "What you need to get done"},
                "limit": {"type": "integer", "description": "Max results (default 8)"},
            },
            "required": ["query"],
        },
        "annotations": {"readOnlyHint": True, "openWorldHint": False},
    },
    {
        "name": "use",
        "description": "Use a toolbox tool found via search. A skill returns instructions "
        "you then follow; an integration carries out the prompt and returns the result, "
        "so make the prompt self-contained (IDs, names, dates, exact wording).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "tool": {"type": "string", "description": "Exact tool name from search"},
                "prompt": {"type": "string", "description": "The full task for this tool"},
            },
            "required": ["tool", "prompt"],
        },
        # An integration can write (send mail, edit pages), so harnesses should gate it.
        "annotations": {"readOnlyHint": False, "destructiveHint": True, "openWorldHint": True},
    },
]


def call_tool(name, args, catalog_path=None):
    tool = next((t for t in TOOLS if t["name"] == name), None)
    if not tool:
        raise ToolboxError(f"unknown tool {name!r}")
    missing = [k for k in tool["inputSchema"]["required"] if not args.get(k)]
    if missing:
        raise ToolboxError(f"{name} needs: {', '.join(missing)}")
    entries = load(catalog_path)
    if name == "search":
        return format_hits(search(entries, args["query"], int(args.get("limit") or 8)))
    return use(entries, args["tool"], args["prompt"])


def serve(inp=sys.stdin, out=sys.stdout, catalog_path=None):
    lock = threading.Lock()
    workers = []

    def send(msg):
        with lock:
            out.write(json.dumps(msg) + "\n")
            out.flush()

    def run_call(rid, params):
        try:
            text = call_tool(params.get("name"), params.get("arguments") or {}, catalog_path)
            result = {"content": [{"type": "text", "text": text}]}
        except (ToolboxError, KeyError, ValueError, OSError) as err:
            result = {"content": [{"type": "text", "text": f"toolbox: {err}"}], "isError": True}
        send({"jsonrpc": "2.0", "id": rid, "result": result})

    for line in inp:
        if not line.strip():
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})
            continue
        rid, method, params = msg.get("id"), msg.get("method"), msg.get("params") or {}
        if rid is None:
            continue  # notifications need no reply
        if method == "initialize":
            send({"jsonrpc": "2.0", "id": rid, "result": {
                "protocolVersion": params.get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "toolbox", "version": "1"},
                "instructions": INSTRUCTIONS,
            }})
        elif method == "ping":
            send({"jsonrpc": "2.0", "id": rid, "result": {}})
        elif method == "tools/list":
            send({"jsonrpc": "2.0", "id": rid, "result": {"tools": TOOLS}})
        elif method == "tools/call":
            # A `use` can run for minutes; do not block other calls behind it.
            t = threading.Thread(target=run_call, args=(rid, params), daemon=True)
            t.start()
            workers.append(t)
        else:
            send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32601, "message": f"unknown method {method}"}})
    for t in workers:
        t.join()


# --- selfcheck -------------------------------------------------------------


def selfcheck():
    import io

    fields, body = frontmatter(
        '---\nname: a\ndescription: "quoted \\"x\\""\nlong: >-\n  one\n  two\nmetadata:\n'
        "  author: z\nplain: first\n  wrapped\n---\n\n# Body\n"
    )
    assert fields["description"] == 'quoted "x"', fields
    assert fields["long"] == "one two", fields
    assert fields["plain"] == "first wrapped", fields
    assert "author" not in fields and body == "# Body\n", (fields, body)
    assert frontmatter("no frontmatter") == ({}, "no frontmatter")

    entries = [
        {"name": "commit-smart", "kind": "skill", "description": "Write conventional git commits"},
        {"name": "Notion", "kind": "integration", "description": "Search and edit Notion pages"},
        {"name": "debug", "kind": "skill", "description": "Investigate logs and commits"},
    ]
    assert search(entries, "commit my changes")[0]["name"] == "commit-smart"
    assert search(entries, "find the notion page about onboarding")[0]["name"] == "Notion"
    assert search(entries, "zzz") == []

    with tempfile.TemporaryDirectory() as d:
        root = Path(d)
        (root / "toolbox").mkdir()
        (root / "skills" / "greet").mkdir(parents=True)
        (root / "skills" / "greet" / "SKILL.md").write_text(
            "---\nname: greet\ndescription: Say hello to someone\n---\nWave at $ARGUMENTS.\n"
        )
        (root / "skills" / "hidden.md").write_text("---\ndisable-model-invocation: true\n---\nno\n")
        cat = root / "toolbox" / "catalog.json"
        cat.write_text(json.dumps({"skills": ["../skills"], "mcp": {"Notion": {
            "type": "claudeai", "description": "Notion pages"}}}))
        names = [e["name"] for e in load(cat)]
        assert names == ["Notion", "greet"], names

        argv = runner_argv(load(cat)[0], "find x")
        assert "--strict-mcp-config" not in argv and "mcp__claude_ai_Notion" in argv, argv
        http = {"name": "srv", "config": {"type": "http", "url": "https://e.x/mcp"}}
        argv = runner_argv(http, "q")
        assert argv[argv.index("--allowedTools") + 1] == "mcp__srv", argv
        assert json.loads(argv[argv.index("--mcp-config") + 1]) == {"mcpServers": {"srv": http["config"]}}

        reqs = [
            {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18"}},
            {"jsonrpc": "2.0", "method": "notifications/initialized"},
            {"jsonrpc": "2.0", "id": 2, "method": "tools/list"},
            {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "search", "arguments": {"query": "hello"}}},
            {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "use", "arguments": {"tool": "greet", "prompt": "Ada"}}},
            {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "use", "arguments": {"tool": "nope", "prompt": "x"}}},
            {"jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": {"name": "search", "arguments": {}}},
        ]
        out = io.StringIO()
        serve(io.StringIO("\n".join(json.dumps(r) for r in reqs) + "\n"), out, cat)
        res = {m["id"]: m for m in map(json.loads, out.getvalue().splitlines())}
        assert sorted(res) == [1, 2, 3, 4, 5, 6], res
        assert res[1]["result"]["serverInfo"]["name"] == "toolbox"
        assert [t["name"] for t in res[2]["result"]["tools"]] == ["search", "use"]
        assert res[3]["result"]["content"][0]["text"].startswith("- greet [skill]")
        assert "Wave at Ada." in res[4]["result"]["content"][0]["text"]
        assert res[5]["result"]["isError"]
        assert res[6]["result"]["content"][0]["text"] == "toolbox: search needs: query"
    print("toolbox selfcheck: ok")
    return 0


# --- CLI -------------------------------------------------------------------


def main(argv):
    ap = argparse.ArgumentParser(prog="toolbox", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("search")
    s.add_argument("query", nargs="+")
    s.add_argument("-n", "--limit", type=int, default=8)
    u = sub.add_parser("use")
    u.add_argument("tool")
    u.add_argument("prompt", nargs="+")
    for name in ("list", "mcp", "selfcheck"):
        sub.add_parser(name)
    a = ap.parse_args(argv)

    if a.cmd == "selfcheck":
        return selfcheck()
    if a.cmd == "mcp":
        serve()
        return 0
    try:
        entries = load()
        if a.cmd == "search":
            print(format_hits(search(entries, " ".join(a.query), a.limit)))
        elif a.cmd == "use":
            print(use(entries, a.tool, " ".join(a.prompt)))
        else:
            for e in entries:
                print(f"{e['name']}\t{e['kind']}")
    except ToolboxError as err:
        print(f"toolbox: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
