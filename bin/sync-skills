#!/usr/bin/env python3
"""Sync shared Linear skills into botfiles or bots, or verify their lockfile."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys

LAYOUTS = {
    "botfiles": {
        "build/create-issue": "skills/create-issue",
        "build/issue-intake": "skills/issue-intake",
        "scripts/sync-linear-skills.py": "bin/sync-skills",
    },
    "bots": {
        "build/issue-intake": "agents/bob/agent/skills/issue-intake",
        "scripts/sync-linear-skills.py": "scripts/sync-linear-skills.py",
    },
}
LOCK = "linear-skills.lock.json"


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def source_files(source, layout):
    files = {}
    for origin, destination in LAYOUTS[layout].items():
        src = source / origin
        if src.is_file():
            files[destination] = src
        elif src.is_dir():
            for file in sorted(src.rglob("*")):
                if file.is_file():
                    files[str(Path(destination) / file.relative_to(src))] = file
        else:
            raise ValueError(f"missing source: {src}")
    return files


def verify(target, lock, source=None):
    expected = lock["files"]
    for name, sha in expected.items():
        path = target / name
        if not path.is_file() or digest(path) != sha:
            raise ValueError(f"shared skill drift: {name}; edit the source and sync")
    for origin, destination in LAYOUTS[lock["layout"]].items():
        if origin.startswith("build/"):
            actual = {str(path.relative_to(target)) for path in (target / destination).rglob("*") if path.is_file()}
            managed = {name for name in expected if name.startswith(destination + "/")}
            if actual != managed:
                raise ValueError(f"unexpected or missing files in {destination}; run sync")
    if source is not None:
        upstream = {name: digest(path) for name, path in source_files(source, lock["layout"]).items()}
        if expected != upstream:
            raise ValueError("source differs from the locked skills; run sync")
    print(f"shared Linear skills: {len(expected)} files verified")


def sync(source, target, layout):
    files = source_files(source, layout)
    lock_path = target / LOCK
    previous = json.loads(lock_path.read_text()) if lock_path.exists() else {"files": {}}
    for name in previous["files"].keys() - files.keys():
        path = target / name
        if path.is_file():
            path.unlink()
    for name, src in files.items():
        dest = target / name
        dest.parent.mkdir(parents=True, exist_ok=True)
        if src.resolve() != dest.resolve():
            shutil.copy2(src, dest)
    revision = subprocess.run(
        ["git", "-C", str(source), "rev-parse", "HEAD"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    dirty = subprocess.run(
        ["git", "-C", str(source), "status", "--porcelain"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    lock = {
        "source": "Bask-Health/skills",
        "revision": revision,
        "working_tree": bool(dirty),
        "layout": layout,
        "files": {name: digest(path) for name, path in files.items()},
    }
    lock_path.write_text(json.dumps(lock, indent=2) + "\n")
    verify(target, lock, source)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, help="local Bask-Health/skills checkout")
    parser.add_argument("--target", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--layout", choices=LAYOUTS)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    try:
        if args.check:
            verify(args.target, json.loads((args.target / LOCK).read_text()), args.source)
        else:
            if args.source is None or args.layout is None:
                parser.error("sync requires --source and --layout")
            sync(args.source, args.target, args.layout)
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"skill sync: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
