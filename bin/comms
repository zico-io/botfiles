#!/usr/bin/env python3
"""comms - thin CLI client for the per-mission comms server (orchestration/comms_server.py).

Pure stdlib; identical on the host and inside a mission microVM. Reads its target
and identity from the environment:

  COMMS_URL    base URL of the mission's comms server, e.g. http://10.0.0.4:54123
  COMMS_TOKEN  the mission's bearer token
  COMMS_AGENT  this caller's identity (role), e.g. lead-a / worker-a-1 / orchestrator

Each subcommand is one HTTP POST. Registration is implicit: the server upserts
COMMS_AGENT on the first call. Prints the server's JSON reply; exits nonzero on error.

  comms whoami | agents | rooms | inbox
  comms status <active|idle|busy|done>
  comms create-room <name> [--type public]
  comms join <room> | leave <room> | destroy-room <room>
  comms send <room> <message...>
  comms dm <agent> <message...>
  comms read <room> [--since <seq>]
  comms invite <room> <agent> | kick <room> <agent>
"""
import json
import os
import sys
import urllib.error
import urllib.request


def die(msg):
    sys.exit(f"comms: {msg}")


def post(action, **fields):
    url = os.environ.get("COMMS_URL")
    token = os.environ.get("COMMS_TOKEN")
    agent = os.environ.get("COMMS_AGENT")
    if not url or not token or not agent:
        die("COMMS_URL, COMMS_TOKEN and COMMS_AGENT must all be set")
    data = json.dumps({"agent": agent, **fields}).encode()
    req = urllib.request.Request(
        f"{url.rstrip('/')}/{action}", data=data,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            detail = json.load(e).get("error", e.reason)
        except Exception:
            detail = e.reason
        die(f"{action}: {e.code} {detail}")
    except urllib.error.URLError as e:
        die(f"cannot reach {url} ({e.reason})")


def parse_opt(args, name):
    """Pull `--name value` out of args, returning (value_or_None, remaining_args)."""
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            die(f"{name} needs a value")
        return args[i + 1], args[:i] + args[i + 2:]
    return None, args


def main(argv):
    if not argv:
        sys.exit(__doc__)
    cmd, rest = argv[0], argv[1:]

    if cmd == "whoami":
        out = post("whoami")
    elif cmd == "agents":
        out = post("agents")
    elif cmd == "rooms":
        out = post("rooms")
    elif cmd == "inbox":
        out = post("inbox")
    elif cmd == "status":
        if len(rest) != 1:
            die("usage: comms status <active|idle|busy|done>")
        out = post("status", state=rest[0])
    elif cmd == "create-room":
        rtype, rest = parse_opt(rest, "--type")
        if len(rest) != 1:
            die("usage: comms create-room <name> [--type public]")
        out = post("create-room", name=rest[0], type=rtype)
    elif cmd in ("join", "leave", "destroy-room"):
        if len(rest) != 1:
            die(f"usage: comms {cmd} <room>")
        out = post(cmd, room=rest[0])
    elif cmd == "send":
        if len(rest) < 2:
            die("usage: comms send <room> <message...>")
        out = post("send", room=rest[0], text=" ".join(rest[1:]))
    elif cmd == "dm":
        if len(rest) < 2:
            die("usage: comms dm <agent> <message...>")
        out = post("dm", to=rest[0], text=" ".join(rest[1:]))
    elif cmd == "read":
        since, rest = parse_opt(rest, "--since")
        if len(rest) != 1:
            die("usage: comms read <room> [--since <seq>]")
        out = post("read", room=rest[0], since=since)
    elif cmd in ("invite", "kick"):
        if len(rest) != 2:
            die(f"usage: comms {cmd} <room> <agent>")
        out = post(cmd, room=rest[0], target=rest[1])
    else:
        die(f"unknown command {cmd!r} (see --help)")

    print(json.dumps(out, indent=2))


if __name__ == "__main__":
    main(sys.argv[1:])
