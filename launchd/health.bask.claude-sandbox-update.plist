<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>health.bask.claude-sandbox-update</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/percules/git/botfiles/scripts/build-claude-sandbox.sh</string>
	</array>

	<!-- 03:00 nightly. launchd runs a missed calendar event once on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/percules/.cache/claude-sandbox/update.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/percules/.cache/claude-sandbox/update.log</string>
</dict>
</plist>
